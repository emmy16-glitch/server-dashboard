  "projects": [
    {
      "id": "agentdesk",
      "name": "AgentDesk",
      "enabled": true,
      "location": {
        "type": "external",
        "agentId": "local",
        "provider": "vercel"
      },
      "runtime": {
        "healthUrl": "https://agentdesk-bnb-eight.vercel.app",
        "autoRestart": false
      },
      "source": {
        "provider": "github",
        "repository": "emmy16-glitch/AgentDesk",
        "branch": "main",
        "deployOnPush": true
      },
      "monitoring": {
        "intervalSeconds": 60,
        "timeoutSeconds": 10,
        "expectedStatus": [
          200
        ]
      },
      "notifications": {
        "down": true,
        "recovered": true
      },
